using UnityEngine;

public class TargetScript : MonoBehaviour
{
    int ctr;
    [SerializeField]
    GameObject targetPrefab;

    [SerializeField]
    Transform targetLoc;
    // Start is called once before the first execution of Update after the MonoBehaviour is created
    void Start()
    {
        ctr = 0;
    }

    // Update is called once per frame
    void Update()
    {
        
    }

    private void OnCollisionEnter(Collision collision)
    {
        ctr++;
        if (ctr++ >= 3)
        {
            Instantiate(targetPrefab, targetLoc.position, targetLoc.rotation);
            Destroy(gameObject);
        }
        MeshRenderer targetRenderer = GetComponent<MeshRenderer>();
        targetRenderer.material.color = new Color(Random.Range(0f, 1f), Random.Range(0f, 1f), Random.Range(0f, 1f));
    }
}
