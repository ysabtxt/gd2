// this is part of the character na may animation

using UnityEngine;
using UnityEngine.InputSystem;

public class charwalk : MonoBehaviour
{
    CharacterController playerCont;
    // Start is called once before the first execution of Update after the MonoBehaviour is created
    void Start()
    {
        playerCont = GetComponent<CharacterController>();
    }

    // Update is called once per frame
    void Update()
    {
        float sprint = 1; //sprint starts at 1

        float fb =
           Keyboard.current.wKey.ReadValue() > 0 ? 1 :
           Keyboard.current.sKey.ReadValue() > 0 ? -1 : 0;

        float lr =
            Keyboard.current.dKey.ReadValue() > 0 ? 1 :
            Keyboard.current.aKey.ReadValue() > 0 ? -1 : 0;

        if (Keyboard.current.leftShiftKey.isPressed && fb > 0) 
        {
            sprint = 2; // doubles forward movement
        }


        playerCont.Move(new Vector3(lr, -1f, fb * sprint) * .1f); //Move() moves the CharacterController by the given distance while accounting for collisions.
    }

}
