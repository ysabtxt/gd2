            PlayerPrefs.SetFloat("z", transform.position.z);
 
            PlayerPrefs.SetFloat("a", transform.localScale.x);
            PlayerPrefs.SetFloat("b", transform.localScale.y);
            PlayerPrefs.SetFloat("c", transform.localScale.z);*/

            //combines cube's position into text
            PlayerPrefs.SetString("pos", transform.position.x + "," + transform.position.y + "," + transform.position.z);

            Color col = GetComponent<MeshRenderer>().material.color;
            PlayerPrefs.SetString("col", col.r + "," + col.g + "," + col.b + "," + col.a);
        }

        if (Keyboard.current.lKey.wasPressedThisFrame) // loading
        {
            //DATA LOADED: POSITION AND COLOR; COMBINED TEXT; CONVERT TEXT TO NUMBERS
            string posData = PlayerPrefs.GetString("pos"); //Gets the text saved under "pos" and stores it in posData.
            string[] splitData = posData.Split(',');
            Vector3 loadData =
                new Vector3(float.Parse(splitData[0]), float.Parse(splitData[1]), float.Parse(splitData[2])); //float.Parse() changes text into a number

