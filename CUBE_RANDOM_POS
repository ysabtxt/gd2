            string[] splitCol=colData.Split(",");
            Color col = new Color(float.Parse(splitCol[0]), float.Parse(splitCol[1]), float.Parse(splitCol[2]), float.Parse(splitCol[3])

                );
            GetComponent<MeshRenderer>().material.color = col;


