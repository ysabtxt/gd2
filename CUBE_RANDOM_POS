using UnityEngine;
using UnityEngine.InputSystem;

//This script gives the cube a random appearance when the game starts,
//then lets you press S to save its position and color and L to load them.

public class CubeScript : MonoBehaviour
{
    // Start is called once before the first execution of Update after the MonoBehaviour is created
    void Start()
    {
        transform.position = //This gives the cube a random location
            new Vector3(Random.Range(-10f, 10f), Random.Range(4f, -4f), 0); // x: horizontal position bet -10 and 10; y: vertical position -4f to 4f; z: stays at 0
        transform.localScale = new Vector3(Random.Range(1f, 5f), Random.Range(1f, 5f), Random.Range(1f, 5f)); // random cube size; random width, height and depth
        
        MeshRenderer cubeRenderer = GetComponent<MeshRenderer>();

        cubeRenderer.material.color = new Color(Random.Range(0f, 1f), Random.Range(0f, 1f), Random.Range(0f, 1f));

        transform.eulerAngles = new Vector3(Random.Range(0, 359), Random.Range(0, 359), Random.Range(0, 359));//This rotates the cube randomly around its X, Y, and Z axes.
    }

    // Update is called once per frame
